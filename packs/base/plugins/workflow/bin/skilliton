#!/usr/bin/env bash
# skilliton: runs the Skilliton runtime shipped inside this plugin. Claude Code puts a plugin's bin/ folder on the
# Bash tool's PATH while the plugin is enabled, so an assistant can type `skilliton status`; anyone else can run this
# file by its path. It needs Node.js 18 or later and says so plainly when node is missing.
set -u
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
if ! command -v node >/dev/null 2>&1; then
  echo "skilliton: node was not found on PATH. Install Node.js 18 or later, then run the command again. Nothing was run." >&2
  exit 3
fi
SKILLITON_SELF="${SKILLITON_SELF:-skilliton}" exec node "$here/../runtime/skilliton.mjs" "$@"
