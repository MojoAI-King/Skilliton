{
  "handoff": {
    "file": "docs/HANDOFF.md",
    "maxBytes": 6000
  },
  "maintain": {
    "teamLessonsFile": null
  },
  "dispatch": {
    "laneRoot": "../Skilliton-lanes",
    "hotspots": [
      ".claude-plugin/marketplace.json",
      "docs/CONTRACTS.md",
      "packs/base/plugins/workflow/templates/harness.md",
      "packs/base/plugins/workflow/runtime/skillgate.mjs",
      "packs/base/plugins/workflow/runtime/lib/core.mjs",
      "packs/base/plugins/workflow/runtime/lib/config.mjs",
      "packs/base/plugins/workflow/hooks/hooks.json",
      "packs/base/plugins/workflow/.claude-plugin/plugin.json"
    ],
    "mainOnlyPaths": [
      "docs/",
      "DECISIONS.md",
      "PLAN.md",
      "README.md",
      "CLAUDE.md"
    ],
    "laneSetup": [],
    "laneTestCommand": null,
    "mainOnlyChecks": [
      "claude plugin eval"
    ],
    "maxItemsPerLane": 8,
    "minItemsForLanes": 6
  },
  "guardrails": {
    "protectedBranches": [
      "main"
    ],
    "blockForcePush": true,
    "blockNoVerify": true,
    "blockSecretFiles": true
  },
  "prepare": {
    "artifacts": {
      "roadmap": "PLAN.md",
      "status": "docs/STATUS.md",
      "backlog": "docs/BACKLOG.md",
      "backlogArchive": "docs/BACKLOG_ARCHIVE.md",
      "decisions": "DECISIONS.md",
      "lessons": "docs/LESSONS.md",
      "handoff": "docs/HANDOFF.md",
      "handoffArchive": "docs/HANDOFF_ARCHIVE.md",
      "maintain": "docs/MAINTAIN.md"
    },
    "integrationBranches": [
      "main"
    ],
    "version": 2,
    "directories": {
      "tasks": "docs/tasks",
      "decisions": "docs/decisions",
      "lessons": "docs/lessons"
    },
    "requires": {
      "workflow": "0.3.0"
    }
  }
}
